events { worker_connections 1024; }
http {
  log_format combined_safe '$remote_addr - $status [$time_local] '
                           '"$request" $body_bytes_sent';
  access_log /var/log/nginx/access.log combined_safe;

  map $http_authorization $token_ok {
    default 0;
    "Bearer ${PROM_BEARER_TOKEN}" 1;
  }

  server {
    listen 9090 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 32m;

    location = /healthz {
      add_header Content-Type text/plain;
      return 200 "ok\n";
    }

    location = /api/v1/write {
      if ($token_ok = 0) { return 401; }
      proxy_pass http://prometheus:9090/api/v1/write;
      proxy_set_header Host $host;
      proxy_read_timeout 60s;
    }

    location / { return 404; }
  }
}
