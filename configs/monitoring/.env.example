# Template for ~iot_bot/monitoring/.env on the droplet.
# Copy to .env (NEVER commit the real file) and fill in real values.
# Both values are consumed by docker-compose.yml.

# Initial admin password for Grafana. Only applied on first start of a
# fresh grafana-data volume; after that, change via the UI and update
# this file to match (it documents the current password, doesn't set it).
GRAFANA_ADMIN_PASSWORD=

# Bearer token clients must send in Authorization: Bearer ... to write
# samples through nginx. Generate fresh with: openssl rand -hex 32
# After changing, re-render nginx/nginx.conf from nginx.conf.template
# and restart the nginx container (see doc/monitoring-server.md).
PROM_BEARER_TOKEN=
